# rclone Google Drive SQL backup sync environment file.
#
# VPS installation path:
#   /etc/rclone-gdrive-sql-backup-sync.env
#
# This file is sourced by Bash. Keep values quoted. Do not commit the real
# production copy because it can reveal folder names, storage layout, and
# operational settings.

###############################################################################
# Required source and destination
###############################################################################

# Name of the rclone remote created with `rclone config`.
# Example rclone source becomes: gdrive:SQL Backups
RCLONE_REMOTE_NAME="gdrive"

# Google Drive folder path containing the SQL backups.
# This must point to a specific folder. The sync script refuses to sync the
# whole Google Drive root because that is too risky for a backup operation.
GDRIVE_SOURCE_PATH="SQL Backups"

# VPS destination folder. The folder name must be dailybackups unless
# ALLOW_NON_DAILYBACKUPS_DESTINATION is set to true.
VPS_DESTINATION_DIR="/dailybackups"

###############################################################################
# First-run safety
###############################################################################

# Keep true while testing. rclone prints what it would do without changing files.
# Set to false only after the dry-run log confirms the correct source/destination.
DRY_RUN="true"

# sync: make destination mirror source, including deletions.
# copy: copy new/changed files only, never delete destination files.
# The project requirement is rclone sync, so sync is the default.
SYNC_MODE="sync"

# If the destination path does not end in dailybackups, the script fails by
# default. Set this true only if the architecture intentionally uses another
# folder name.
ALLOW_NON_DAILYBACKUPS_DESTINATION="false"

###############################################################################
# Deletion and overwrite protection
###############################################################################

# When SYNC_MODE=sync, rclone can delete destination files that no longer exist
# in Google Drive. This option moves deleted/overwritten destination files to
# ARCHIVE_BASE_DIR/<run-id> instead of removing them permanently.
ARCHIVE_DELETED_FILES="true"
ARCHIVE_BASE_DIR="/var/backups/rclone-gdrive-sql-backup-sync/archive"

###############################################################################
# Optional filtering
###############################################################################

# Leave empty to sync every file in the Google Drive source folder.
# To sync common SQL backup file types only, copy the example filter from:
#   /etc/rclone-gdrive-sql-backup-sync/sql-backups.filter.example
# to:
#   /etc/rclone-gdrive-sql-backup-sync/sql-backups.filter
# then set:
#   RCLONE_FILTER_FILE="/etc/rclone-gdrive-sql-backup-sync/sql-backups.filter"
RCLONE_FILTER_FILE=""

###############################################################################
# Performance and reliability
###############################################################################

RCLONE_TRANSFERS="4"
RCLONE_CHECKERS="8"
RCLONE_RETRIES="3"
RCLONE_LOW_LEVEL_RETRIES="10"
RCLONE_STATS_INTERVAL="30s"
RCLONE_LOG_LEVEL="INFO"

# true can speed up large Drive listings, but uses more memory.
RCLONE_FAST_LIST="false"

# Optional bandwidth limit. Examples: 10M, 100M, 1G. Leave empty for unlimited.
RCLONE_BWLIMIT=""

# true asks rclone to compare checksums where the backend supports them.
# This is stronger but can be slower.
VERIFY_WITH_CHECKSUM="false"

# true runs `rclone check --one-way` after the sync. This increases confidence
# but adds time and API calls. Recommended after first production deployment,
# then decide based on backup size and Google API quota.
POST_SYNC_CHECK="false"

# Minimum free bytes required on the destination filesystem before sync starts.
# Default here is 10 GiB.
MIN_FREE_SPACE_BYTES="10737418240"

###############################################################################
# Runtime paths and retention
###############################################################################

LOG_DIR="/var/log/rclone-gdrive-sql-backup-sync"
STATE_DIR="/var/lib/rclone-gdrive-sql-backup-sync"

# Bash umask for created files. 077 means only the service user/root can read
# new files unless filesystem ACLs or ownership are changed later.
FILE_UMASK="077"

# Delete old script log files after this many days. 0 disables cleanup.
LOG_RETENTION_DAYS="30"

# Delete old archive directories after this many days. 0 disables cleanup.
# Keep 0 until the business retention policy is formally approved.
ARCHIVE_RETENTION_DAYS="0"

###############################################################################
# Advanced
###############################################################################

# Binary name or absolute path. Usually keep this as rclone.
RCLONE_BIN="rclone"

# If the systemd service runs as root, rclone normally reads:
#   /root/.config/rclone/rclone.conf
# If you store the config somewhere else, uncomment and set RCLONE_CONFIG.
# RCLONE_CONFIG="/root/.config/rclone/rclone.conf"
