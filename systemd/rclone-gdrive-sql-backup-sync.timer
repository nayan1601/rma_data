[Unit]
Description=Check Google Drive SQL backups every 30 minutes

[Timer]
# Check twice per hour, at minute 00 and minute 30, in the VPS local timezone.
# This provides automatic fetch within 30 minutes of a Google Drive upload in
# normal operation. AccuracySec is kept strict so systemd does not coalesce the
# run far beyond the target window.
OnCalendar=*:0/30
OnBootSec=5m
Persistent=true
RandomizedDelaySec=0
AccuracySec=1s
Unit=rclone-gdrive-sql-backup-sync.service

[Install]
WantedBy=timers.target
